{
  "servers": {
    "jira": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "mcp_atlassian"
      ],
      "env": {
        "JIRA_URL": "${JIRA_URL}",
        "JIRA_USERNAME": "${JIRA_USERNAME}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
      }
    }
  }
}